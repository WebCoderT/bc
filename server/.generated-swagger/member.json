  "info": {
    "title": "Member API",
    "description": "普通用户与 VIP 用户文档",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "请填入登录后返回的 accessToken"
      }
    },
    "schemas": {
      "SafeUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "username": {
            "type": "string",
            "example": "admin_root"
          },
          "avatar": {
            "type": "string",
            "example": "data:image/svg+xml;utf8,..."
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "vip",
              "admin"
            ],
            "example": "admin"
          },
          "rechargeAmount": {
            "type": "number",
            "example": 2000
          },
          "bonusAmount": {
            "type": "number",
            "example": 300
          },
          "totalBalance": {
            "type": "number",
            "example": 2300
          },
          "createdAt": {
            "type": "string",
            "example": "2026-05-14T08:30:00.000Z"
          },
          "isOnline": {
            "type": "boolean",
            "example": true
          },
          "onlineStatus": {
            "type": "string",
            "example": "online"
          },
          "currentGameRoomId": {
            "type": "object",
            "example": 101,
            "nullable": true
          },
          "currentGameRoomLabel": {
            "type": "object",
            "example": "排列5",
            "nullable": true
          },
          "lastActiveAt": {
            "type": "object",
            "example": "2026-05-19T08:30:00.000Z",
            "nullable": true
          }
        },
        "required": [
          "id",
          "username",
          "avatar",
          "role",
          "rechargeAmount",
          "bonusAmount",
          "totalBalance",
          "createdAt",
          "isOnline",
          "onlineStatus"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "new_user"
          },
          "password": {
            "type": "string",
            "example": "StrongPass123"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "user": {
            "$ref": "#/components/schemas/SafeUserDto"
          }
        },
        "required": [
          "accessToken",
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "username": {
